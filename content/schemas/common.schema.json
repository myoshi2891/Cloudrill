{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examprep-content.invalid/schemas/common.schema.json",
  "title": "共通定義",
  "description": "各コンテンツ Schema から $ref で参照する共通定義。",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "LocalizedText": {
      "description": "多言語テキスト。ja は必須・空文字不可。en の欠落は validate.py が CI-11 として警告する。",
      "type": "object",
      "properties": {
        "ja": { "$ref": "#/$defs/NonEmptyString" },
        "en": { "type": "string" }
      },
      "required": ["ja"],
      "additionalProperties": false
    },
    "Domain": {
      "description": "ドメイン番号。上限は exam.yaml の domains との照合(CI-09)と Swift 側の対応がそろうまで固定する(P0-S05)。",
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "SubObjective": {
      "description": "試験ガイドのサブ項目(例: 3.2、NET.1)。exam.yaml に実在するかは CI-09 が確認する。QuestionID と CardID のパターンは、この正規表現を Q- / C- と -NNNN で挟んだもの(JSON Schema では正規表現を合成できないため、変更するときは3つをそろえる)。",
      "type": "string",
      "pattern": "^[0-9A-Za-z]+(\\.[0-9A-Za-z]+)*$"
    },
    "QuestionID": {
      "type": "string",
      "description": "Q-<SubObjective>-<4桁>。",
      "pattern": "^Q-[0-9A-Za-z]+(\\.[0-9A-Za-z]+)*-[0-9]{4}$"
    },
    "CardID": {
      "type": "string",
      "description": "C-<SubObjective>-<4桁>。",
      "pattern": "^C-[0-9A-Za-z]+(\\.[0-9A-Za-z]+)*-[0-9]{4}$"
    },
    "ExamSetNumber": {
      "description": "模試の番号。exam.yaml の format.mockExam.setCount 以下かは CI-02 が確認する。",
      "type": "integer",
      "minimum": 1
    },
    "ExamGuideVersion": {
      "description": "試験ガイドのバージョン(例: \"6.1\")。YAML では数値にならないよう引用符で囲む。",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "HttpsURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s/$.?#][^\\s]*$"
    },
    "Identifier": {
      "description": "ディシジョンツリーやドリルなどで使う汎用 ID。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "ExamID": {
      "description": "試験の ID(例: gcp-pca)。<ベンダー略称>-<試験略称> を推奨。ディレクトリ名との一致は CI-12 が確認する。",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "VendorID": {
      "description": "ベンダーの ID(例: google-cloud)。vendors.yaml に実在するかは CI-12 が確認する。",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "QuestionKind": {
      "description": "出題形式(構造語彙)。値を追加するときはアプリの更新が必要。",
      "type": "string",
      "enum": ["single", "multiple"]
    },
    "CaseStudyID": {
      "description": "ケーススタディの ID(試験語彙)。exam.yaml の caseStudies との照合(CI-09・CI-12)と Swift 側の対応がそろうまで列挙で固定する(P0-S05)。",
      "type": "string",
      "enum": ["ehr", "altostrat", "cymbal", "knightMotives"]
    },
    "WAFPillarID": {
      "description": "Well-Architected Framework の柱の ID(試験語彙)。exam.yaml の taxonomies.wafPillars との照合(CI-09)と Swift 側の対応がそろうまで列挙で固定する(P0-S05)。",
      "type": "string",
      "enum": [
        "operationalExcellence",
        "security",
        "reliability",
        "costOptimization",
        "performance",
        "sustainability"
      ]
    },
    "MistakeTag": {
      "type": "string",
      "enum": [
        "cost",
        "opsOverhead",
        "compliance",
        "scalability",
        "availability",
        "latency",
        "requirementMismatch",
        "deprecated"
      ]
    },
    "License": {
      "type": "string",
      "enum": ["CC-BY-4.0", "Apache-2.0", "link-only"]
    },
    "Reference": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "url": { "$ref": "#/$defs/HttpsURL" },
        "license": { "$ref": "#/$defs/License" }
      },
      "required": ["title", "url", "license"],
      "additionalProperties": false
    },
    "References": {
      "type": "array",
      "items": { "$ref": "#/$defs/Reference" },
      "minItems": 1
    }
  }
}
